{
  "name": "clipsflow",
  "version": "0.1.0",
  "description": "Video clip workflow management API",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "bot": "node dist/discord/index.js",
    "bot:dev": "node --loader ts-node/esm src/discord/index.ts",
    "bot:register": "node dist/discord/register.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
