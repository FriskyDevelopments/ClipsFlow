{
  "name": "clipsflow",
  "version": "0.1.0",
  "description": "Video clip workflow management API + Discord bot on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bot:register": "node --loader ts-node/esm src/discord/register.ts",
    "db:create": "wrangler d1 create clipsflow",
    "db:migrate": "wrangler d1 migrations apply clipsflow --remote",
    "db:migrate:local": "wrangler d1 migrations apply clipsflow --local"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "hono": "^4.6.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "wrangler": "^3.78.0"
  }
}
