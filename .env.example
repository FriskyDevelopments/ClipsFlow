# ClipsFlow runs on Cloudflare Workers. Runtime config lives in wrangler.toml
# ([vars]) and Worker secrets (`wrangler secret put ...`), NOT in this file.
#
# This .env is only consumed by the local slash-command registration script
# (`npm run bot:register`), which talks to the Discord REST API from Node.

# Bot token from the Discord Developer Portal (Bot → Reset Token).
DISCORD_BOT_TOKEN=
# Application (client) ID — used to register slash commands.
DISCORD_CLIENT_ID=
# Optional: register commands to a single guild for instant availability in
# dev. Leave blank to register globally (propagation can take up to ~1h).
DISCORD_GUILD_ID=

# Reference only — set these on the Worker, not here:
#   wrangler secret put DISCORD_PUBLIC_KEY   # Discord app public key (interaction verify)
#   wrangler.toml [vars]: RATE_LIMIT_WINDOW_MS, RATE_LIMIT_MAX
