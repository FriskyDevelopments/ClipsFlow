# ClipFLOW environment example
# Copy to .env only for local development.
# Production should inject secrets via Doppler.

# Required secrets (comma-separated env names that must be present at startup)
REQUIRED_SECRETS=TELEGRAM_BOT_TOKEN

# Telegram
TELEGRAM_BOT_TOKEN=__REQUIRED__
TELEGRAM_API_ID=37265246
TELEGRAM_API_HASH=d03fb9f3c1a1f755cfb61d4402a5d889

# Providers (comma-separated; valid: mock,youtube)
ENABLED_PROVIDERS=mock
YOUTUBE_API_KEY=

# Clip constraints
CLIP_MAX_DURATION_SECONDS=300
CLIP_MAX_FILE_SIZE_MB=50
CLIP_ALLOWED_MEDIA_TYPES=video

# Processing
TELEGRAM_MAX_UPLOAD_MB=50
DOWNLOAD_DIR=/tmp/clipflow
FFMPEG_PATH=ffmpeg
ENABLE_COMPRESSION=true
PROCESSING_TIMEOUT_SECONDS=180

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
MINIAPP_URL=https://clipsflow.tech/miniapp

# Doppler metadata (required when APP_ENV=production)
DOPPLER_PROJECT=
DOPPLER_CONFIG=
