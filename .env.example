# Port the API listens on
PORT=3000

# Directory for the JSON file store. In production point this at a mounted
# volume so clips survive restarts. Defaults to ./data when unset.
CLIPS_DATA_DIR=./data

# Rate limiting (applies to /api/v1). Defaults: 100 requests / 60s per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Discord bot (only needed to run `npm run bot`) ---
# Bot token from the Discord Developer Portal (Bot → Reset Token).
DISCORD_BOT_TOKEN=
# Application (client) ID — used to register slash commands.
DISCORD_CLIENT_ID=
# Optional: register commands to a single guild for instant availability in
# dev. Leave blank to register globally (propagation can take up to ~1h).
DISCORD_GUILD_ID=
