# ClipFLOW environment example
# Copy to .env only for local development.
# Production should inject secrets via Doppler.

# Required secrets (comma-separated env names that must be present at startup)
REQUIRED_SECRETS=TELEGRAM_BOT_TOKEN

# Telegram
TELEGRAM_BOT_TOKEN=__REQUIRED__
TELEGRAM_API_ID=37265246
TELEGRAM_API_HASH=d03fb9f3c1a1f755cfb61d4402a5d889

# Providers (comma-separated; valid: mock,direct,youtube,tiktok,instagram,x)
CLIP_PROVIDER=mock
YOUTUBE_API_KEY=
YTDLP_IMPERSONATE=
YTDLP_COOKIE_FILE=
YTDLP_COOKIES_B64=

# Clip constraints
CLIP_MAX_DURATION_SECONDS=300
CLIP_MAX_FILE_SIZE_MB=50
CLIP_ALLOWED_MEDIA_TYPES=video

# Processing
TELEGRAM_MAX_UPLOAD_MB=50
DOWNLOAD_DIR=/tmp/clipflow
FFMPEG_PATH=ffmpeg
ENABLE_COMPRESSION=true
PROCESSING_TIMEOUT_SECONDS=180
TELEGRAM_DELIVERY_TIMEOUT_SECONDS=600
FREE_WATERMARK_ENABLED=true
FREE_WATERMARK_TEXT=ClipFLOW Free
FREE_TRIAL_EXPORT_LIMIT=25

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
MINIAPP_URL=https://clipsflow.tech/miniapp
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRISKYDEV_ENVIRONMENT=friskydev
TELEGRAM_STARS_PRO_PRICE=250

# ClipsFlow web billing / Stripe
# Used by apps/web. Keep secret values in Doppler or the deployment provider.
STRIPE_SECRET_KEY=__REQUIRED_FOR_BILLING__
STRIPE_WEBHOOK_SECRET=__REQUIRED_FOR_BILLING__
STRIPE_PRICE_PRO_MONTHLY=price_replace_with_clipsflow_pro_monthly

# Doppler metadata (required when APP_ENV=production)
DOPPLER_PROJECT=
DOPPLER_CONFIG=
